import torch
import torch.nn.functional as F

# Load the names and build the character list
words = open("names.txt", "r").read().splitlines()
chas = sorted(list(set(''.join(words))))

# String to integer: letters get 1-26, '.' gets 0
stoi = {}
for i, s in enumerate(chas):
    stoi[s] = i + 1
stoi['.'] = 0

# Integer to string: the reverse lookup
itos = {}
for s, i in stoi.items():
    itos[i] = s

# Build the training set of bigrams (x = current char, y = next char)
xs, ys = [], []

for w in words:
    chs = ['.'] + list(w) + ['.']
    for ch1, ch2 in zip(chs, chs[1:]):
        ix1 = stoi[ch1]
        ix2 = stoi[ch2]
        xs.append(ix1)
        ys.append(ix2)

xs = torch.tensor(xs)
ys = torch.tensor(ys)
num = len(xs)

# Create the seeded generator first, then initialize the weights
g = torch.Generator().manual_seed(2147483647)  # Set the random seed for reproducibility
W = torch.randn((27, 27), generator=g, requires_grad=True)  # Randomly initialize the weight matrix

# One-hot encode once: the inputs never change
xenc = F.one_hot(xs, num_classes=27).float()  # (num x 27)

# Training (no printing)
for k in range(100):  # Train for 100 iterations
    # Forward Pass
    logits = xenc @ W  # (num x 27) @ (27 x 27) -> (num x 27): log counts
    counts = logits.exp()  # Convert log counts to counts
    probs = counts / counts.sum(1, keepdim=True)  # Normalize each row to sum to 1

    # Finding Loss
    nll = -probs[torch.arange(num), ys].log().mean()  # Average negative log likelihood
    loss = nll + 0.01 * (W**2).mean()  # Add regularization to keep weights small

    # Backward Pass
    W.grad = None  # Clear previous gradients
    loss.backward()  # Compute gradients of the loss with respect to the weights
    W.data += -50 * W.grad  # Gradient descent step with a learning rate of 50

with torch.no_grad():  # No training below, so don't track gradients
    # Sampling 5 names from the NN
    for i in range(5):
        out = []
        ix = 0  # Start with the '.' token
        while True:
            xenc_s = F.one_hot(torch.tensor([ix]), num_classes=27).float()  # (1 x 27)
            logits = xenc_s @ W  # (1 x 27) @ (27 x 27) -> (1 x 27)
            counts = logits.exp()
            p = counts / counts.sum(1, keepdim=True)  # Probabilities for the next character
            ix = torch.multinomial(p, num_samples=1, replacement=True, generator=g).item()
            if ix == 0:  # Sampled '.', so the name is finished
                break
            out.append(itos[ix])
        print(''.join(out))

    # Final NLL of the trained model on the whole dataset
    logits = xenc @ W
    counts = logits.exp()
    probs = counts / counts.sum(1, keepdim=True)
    nll = -probs[torch.arange(num), ys].log().mean()
    print(f"NLL: {nll.item():.4f}")
