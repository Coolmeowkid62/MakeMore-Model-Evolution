import torch
import matplotlib.pyplot as plt
import torch.nn.functional as F

# ------------------------------------------------------------------
# Build bigram count model
# ------------------------------------------------------------------
words = open("names.txt", "r").read().splitlines()
N = torch.zeros(27, 27, dtype=torch.int32)
chas = sorted(list(set(''.join(words))))

stoi = {}
for i, s in enumerate(chas):
    stoi[s] = i + 1
stoi['.'] = 0
itos = {}
for s, i in stoi.items():
    itos[i] = s

for w in words:
    chs = ['.'] + list(w) + ['.']
    for ch1, ch2 in zip(chs, chs[1:]):
        N[stoi[ch1], stoi[ch2]] += 1

plt.figure(figsize=(16, 16))
plt.imshow(N, cmap='Blues')
for i in range(27):
    for j in range(27):
        chstr = itos[i] + itos[j]
        plt.text(j, i, chstr, ha='center', va='bottom', color='gray', fontsize=8)
        plt.text(j, i, str(N[i, j].item()), ha='center', va='top', color='gray', fontsize=8)
plt.axis('off')
plt.show()

# ------------------------------------------------------------------
# Normalize to probabilities and sample names
# ------------------------------------------------------------------
P = (N+1).float() # N+1 Creates Model Smoothing 
P /= P.sum(1, keepdim=True)       

g = torch.Generator().manual_seed(2147483647)

for _ in range(20):
    out = []
    ix = 0
    while True:
        p = P[ix]
        ix = torch.multinomial(p, num_samples=1, replacement=True, generator=g).item()
        if ix == 0:
            break
        out.append(itos[ix])
    print(''.join(out))           

# ------------------------------------------------------------------
# Loss: average negative log likelihood
# ------------------------------------------------------------------
log_likelihood = 0.0
n = 0
for w in words:
    chs = ['.'] + list(w) + ['.']
    for ch1, ch2 in zip(chs, chs[1:]):
        prob = P[stoi[ch1], stoi[ch2]]
        logprob = torch.log(prob)
        log_likelihood += logprob
        n += 1

nll = -log_likelihood
print(f'Average NLL: {(nll / n).item():.4f}')
